# ═══════════════════════════════════════════════════════════════════════════════
# FFE Trading Bot - Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────────────
# Trading Mode
# ─────────────────────────────────────────────────────────────────────────────────

# Paper trading mode - simulates trades without real orders
# true = simulation (paper trading), false = live trading
# In simulation mode:
#   - Uses virtual $10k equity
#   - Simulates order fills with realistic slippage
#   - Tracks P&L, MAE/MFE, fees as if real
#   - No API keys required
FFE_SIMULATION=true

# ─────────────────────────────────────────────────────────────────────────────────
# Telegram Bot
# Get token from @BotFather, chat ID from @userinfobot
# ─────────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────────
# Binance Futures API
# Create API keys at https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binancefuture.com
# ─────────────────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=false

# ─────────────────────────────────────────────────────────────────────────────────
# Database Connections
# ─────────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ffe_bot

# ─────────────────────────────────────────────────────────────────────────────────
# Trading Symbols
# Format: BASE/QUOTE:SETTLE (e.g., ETH/USDT:USDT for ETHUSDT perpetual)
# Multiple symbols separated by comma
# ─────────────────────────────────────────────────────────────────────────────────
# Symbols to monitor and trade
FFE_SYMBOLS=ETH/USDT:USDT

# ═══════════════════════════════════════════════════════════════════════════════
# LIQUIDATION BURST DETECTOR (LIQ_BURST)
# Detects liquidation cascades - the core signal for FFE strategy
# ═══════════════════════════════════════════════════════════════════════════════

# Minimum price return in 30s to consider as significant move
# 0.006 = 0.6% (good for ETH), use 0.01 = 1% for altcoins
FFE_LIQ_MIN_RET_30S=0.006
# Multiplier for median liquidation notional
# Burst triggers when: liq_notional > k * median_liq_notional_1h
# Higher = fewer but stronger signals (8-10 recommended)
FFE_LIQ_K_MEDIAN=8
# Absolute minimum liquidation notional in USD to trigger
# $10M for ETH/BTC, $3M for mid-cap alts, $1M for small alts
FFE_LIQ_MIN_NOTIONAL=10000000
# Cooldown after detection in seconds
# Prevents multiple triggers on same cascade
FFE_LIQ_COOLDOWN_SEC=60

# ═══════════════════════════════════════════════════════════════════════════════
# OI CROWDING DETECTOR (OI_CROWDING)
# Detects crowded positions that may unwind violently
# ═══════════════════════════════════════════════════════════════════════════════

# Minimum OI increase to trigger (as decimal)
# 0.05 = 5% OI growth in lookback period
FFE_CROWDING_MIN_OI_CHANGE=0.05
# How far back to measure OI change (minutes)
# 30 = compare current OI to 30 minutes ago
FFE_CROWDING_OI_LOOKBACK_MIN=30
# Funding rate threshold for "extreme" (as decimal)
# 0.0005 = 0.05% per 8h (annualized ~22%)
# Positive = longs crowded, Negative = shorts crowded
FFE_CROWDING_FUNDING_THRESHOLD=0.0005
# Max price range for stall confirmation (as decimal)
# 0.002 = 0.2% range in last 10s = price is flat
FFE_CROWDING_MAX_STALL_RANGE=0.002
# Cooldown after detection (seconds)
# Longer than liq burst since crowding unwinds slower
FFE_CROWDING_COOLDOWN_SEC=300

# ═══════════════════════════════════════════════════════════════════════════════
# STALL/ABSORPTION DETECTION
# Waits for "second breath" - when forced flow exhausts and price stalls
# This is where the edge is: entering AFTER the impulse, not during
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum price range to consider as "stall" (as decimal)
# 0.0012 = 0.12% range in 10s = price is flat despite selling pressure
FFE_STALL_MAX_RANGE_PCT=0.0012
# Minimum book replenishment score (0-1)
# Higher = orderbook refills faster after hits = stronger absorption
# 0.6 = moderate absorption, 0.8 = strong absorption
FFE_STALL_MIN_REPLENISH=0.6
# Minimum wait time after forced event before looking for stall (seconds)
# Don't enter too early - let the impulse play out
FFE_STALL_WAIT_MIN_SEC=30
# Maximum wait time - if no stall found, cancel setup (seconds)
# 300 = 5 minutes max wait for absorption pattern
FFE_STALL_WAIT_MAX_SEC=300
# Buffer above/below stall range for breakout entry (as decimal)
# 0.0005 = 0.05% buffer to avoid false breakouts
FFE_STALL_BREAKOUT_BUFFER=0.0005

# ═══════════════════════════════════════════════════════════════════════════════
# RISK MANAGEMENT
# Conservative defaults - adjust based on your risk tolerance
# ═══════════════════════════════════════════════════════════════════════════════

# Risk per trade as fraction of equity
# 0.005 = 0.5% of equity at risk per trade
# Range: 0.0025 (0.25%) to 0.0075 (0.75%) recommended for MVP
FFE_RISK_PER_TRADE=0.005
# Minimum risk per trade (floor)
# 0.0025 = 0.25% minimum
FFE_MIN_RISK_PER_TRADE=0.0025
# Maximum concurrent positions
# 1 = one position at a time (safest for MVP)
FFE_MAX_CONCURRENT=1
# Daily loss limit as fraction of equity
# 0.015 = 1.5% daily loss limit - trading halts if exceeded
FFE_DAILY_LOSS_LIMIT=0.015
# Maximum notional per trade in USD
# Caps position size regardless of risk calculation
FFE_MAX_NOTIONAL=15000

# ═══════════════════════════════════════════════════════════════════════════════
# EXIT RULES (Take Profit / Stop Loss)
# ═══════════════════════════════════════════════════════════════════════════════

# TP1: First take profit level in R multiples
# 1.0 = take profit at 1R (risk:reward = 1:1)
FFE_TP1_MULT=1.0
# Percentage of position to close at TP1
# 0.5 = close 50% at TP1, let rest run
FFE_TP1_CLOSE_PCT=0.5
# TP2: Second take profit level in R multiples
# 2.0 = take profit at 2R for remaining position
FFE_TP2_MULT=2.0
# R level to activate trailing stop
# 0.8 = start trailing when position is +0.8R
FFE_TRAIL_ACTIVATE_R=0.8
# Buffer for stop loss placement (as decimal)
# 0.001 = 0.1% buffer beyond impulse extreme
FFE_STOP_BUFFER=0.001

# ═══════════════════════════════════════════════════════════════════════════════
# DATA POLLING INTERVALS
# ═══════════════════════════════════════════════════════════════════════════════

# Open Interest polling interval (seconds)
# OI doesn't change rapidly, 60s is sufficient
FFE_OI_POLL_INTERVAL_SEC=60
# Funding rate polling interval (seconds)
# Funding updates every 8h, but we poll more often for changes
FFE_FUNDING_POLL_INTERVAL_SEC=300
