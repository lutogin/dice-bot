sequenceDiagram
  autonumber
  participant IDX as index.ts (AppBootstrap)
  participant CFG as ConfigService
  participant STORE as StateStore
  participant ORCH as ExecutionOrchestrator
  participant STRAT as StrategyEngine
  participant RISK as RiskManager
  participant PRICE as PriceService
  participant LP as LpPositionService
  participant WAL as WalletService
  participant HEDGE as HedgeService
  participant LED as LedgerService
  participant LOG as MonitoringService

  IDX->>CFG: load + validate env/config
  IDX->>STORE: init (connect DB, load activeTokenId)
  IDX->>ORCH: startMainLoop()
  IDX->>ORCH: startStuckOpWatcher() (optional)

  loop every LOOP_INTERVAL_SEC (single decision loop)
    ORCH->>STORE: hasInFlightOp?
    alt in-flight op exists
      ORCH->>ORCH: resume(op) (idempotent)
    else no in-flight op
      ORCH->>PRICE: getReferencePrice()
      ORCH->>LP: getPosition/activeTokenId composition
      ORCH->>HEDGE: getShortPosition + margin
      ORCH->>RISK: evaluate(rpc/cex/price/margin)
      alt risk.emergency
        ORCH->>ORCH: emergencyExit()
        ORCH->>LED: record emergency
        ORCH->>LOG: alertCritical
      else normal
        ORCH->>STRAT: buildActionPlan(price, lp, hedge, risk)
        alt plan = RESET_RANGE
          ORCH->>STORE: beginOp(RESET_RANGE)
          ORCH->>HEDGE: hedgeSafetyIfNeeded()
          ORCH->>LP: decreaseLiquidity(oldNFT)
          ORCH->>LP: collect(oldNFT)
          ORCH->>WAL: rebalanceTo50/50 swap (if threshold)
          ORCH->>LP: mintNewNFT(newTicks, budgetPolicy)
          ORCH->>LP: getComposition(newNFT)
          ORCH->>HEDGE: setTargetShortNotional(afterReset)
          ORCH->>LED: record reset fees/costs
          ORCH->>STORE: completeOp + update activeTokenId
        else plan = REHEDGE
          ORCH->>HEDGE: setTargetShortNotional(target)
          ORCH->>LED: record hedge trade/fees
        else plan = NONE
          ORCH->>LED: optional heartbeat metrics
        end
      end
    end
  end
