{
  "name": "atlas-trading-bot",
  "version": "1.0.0",
  "description": "Atlas Trading Bot for ADN-CLP Hedged Liquidity Provision",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "dev:watch": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "test:hedge": "jest --testPathPatterns=hedge.service.integration --no-coverage",
    "test:hedge:readonly": "jest --testPathPatterns=hedge.service.integration --testNamePattern='Connectivity|Volatility' --no-coverage",
    "test:hedge:lifecycle": "jest --testPathPatterns=hedge.service.integration --testNamePattern='lifecycle' --no-coverage",
    "test:hedge:all": "jest --testPathPatterns=hedge.service.integration --no-coverage --runInBand",
    "test:range-model": "jest --testPathPatterns=range-model.service.integration --no-coverage",
    "test:lp": "jest --testPathPatterns=lp-position.service.integration --no-coverage",
    "test:wallet": "jest --testPathPatterns=wallet.service.integration --no-coverage",
    "test:wallet:readonly": "jest --testPathPatterns=wallet.service.integration --testNamePattern='Prerequisites|Balances|Token Info|Allowances|Configuration' --no-coverage",
    "test:wallet:rebalance": "jest --testPathPatterns=wallet.service.integration --testNamePattern='Rebalance' --no-coverage",
    "test:integration:hedge": "npm run test:hedge",
    "test:integration:range": "npm run test:range-model",
    "test:integration:lp": "npm run test:lp",
    "test:integration:wallet": "npm run test:wallet",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "monitor-spread": "ts-node src/integrations/exchanges/monitoring/monitor-spread.ts"
  },
  "keywords": [
    "atlas",
    "trading",
    "crypto",
    "bot",
    "ADN-CLP",
    "hedged-LP"
  ],
  "author": "@lutogin",
  "license": "MIT",
  "dependencies": {
    "@typegoose/typegoose": "^12.20.0",
    "@types/node-cache": "^4.2.5",
    "@types/ws": "^8.18.1",
    "@uniswap/sdk-core": "^7.10.1",
    "@uniswap/v3-sdk": "^3.27.0",
    "axios": "^1.13.2",
    "binance": "^3.1.5",
    "dayjs": "^1.11.19",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "eventemitter3": "^5.0.1",
    "joi": "^18.0.2",
    "jsbi": "^3.1.4",
    "lodash": "^4.17.21",
    "mongoose": "^8.19.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.66.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "winston": "^3.18.3",
    "winston-loki": "^6.1.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/moment": "^2.13.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
